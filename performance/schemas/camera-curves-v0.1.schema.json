{
  "$defs": {
    "CameraCurveSample": {
      "additionalProperties": false,
      "properties": {
        "focal_length_mm": {
          "maximum": 300.0,
          "minimum": 8.0,
          "title": "Focal Length Mm",
          "type": "number"
        },
        "frame_index": {
          "minimum": 0,
          "title": "Frame Index",
          "type": "integer"
        },
        "position": {
          "$ref": "#/$defs/Vector3"
        },
        "rotation": {
          "$ref": "#/$defs/Quaternion"
        }
      },
      "required": [
        "frame_index",
        "position",
        "rotation",
        "focal_length_mm"
      ],
      "title": "CameraCurveSample",
      "type": "object"
    },
    "CameraResamplingRecord": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "endpoint-preserving-linear-slerp-v1",
          "default": "endpoint-preserving-linear-slerp-v1",
          "title": "Method",
          "type": "string"
        },
        "source_fps": {
          "maximum": 240,
          "minimum": 1,
          "title": "Source Fps",
          "type": "integer"
        },
        "source_frame_count": {
          "exclusiveMinimum": 0,
          "title": "Source Frame Count",
          "type": "integer"
        }
      },
      "required": [
        "source_fps",
        "source_frame_count"
      ],
      "title": "CameraResamplingRecord",
      "type": "object"
    },
    "CoordinateSpace": {
      "additionalProperties": false,
      "properties": {
        "distance_unit": {
          "const": "meter",
          "default": "meter",
          "title": "Distance Unit",
          "type": "string"
        },
        "forward_axis": {
          "const": "-z",
          "default": "-z",
          "title": "Forward Axis",
          "type": "string"
        },
        "handedness": {
          "const": "right",
          "default": "right",
          "title": "Handedness",
          "type": "string"
        },
        "rotation_representation": {
          "const": "quaternion_xyzw",
          "default": "quaternion_xyzw",
          "title": "Rotation Representation",
          "type": "string"
        },
        "up_axis": {
          "const": "y",
          "default": "y",
          "title": "Up Axis",
          "type": "string"
        }
      },
      "title": "CoordinateSpace",
      "type": "object"
    },
    "Quaternion": {
      "additionalProperties": false,
      "properties": {
        "w": {
          "title": "W",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "title": "Quaternion",
      "type": "object"
    },
    "Vector3": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Vector3",
      "type": "object"
    }
  },
  "$id": "https://schemas.cutsceneai.dev/performance/v0.1/camera-curves.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Artifact Version",
      "type": "string"
    },
    "camera_profile": {
      "const": "cutsceneai-camera-v1",
      "default": "cutsceneai-camera-v1",
      "title": "Camera Profile",
      "type": "string"
    },
    "coordinate_space": {
      "$ref": "#/$defs/CoordinateSpace"
    },
    "fps": {
      "maximum": 240,
      "minimum": 1,
      "title": "Fps",
      "type": "integer"
    },
    "frame_count": {
      "exclusiveMinimum": 0,
      "title": "Frame Count",
      "type": "integer"
    },
    "projection": {
      "const": "perspective",
      "default": "perspective",
      "title": "Projection",
      "type": "string"
    },
    "resampling": {
      "anyOf": [
        {
          "$ref": "#/$defs/CameraResamplingRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/CameraCurveSample"
      },
      "minItems": 1,
      "title": "Samples",
      "type": "array"
    },
    "sensor_height_mm": {
      "default": 20.25,
      "exclusiveMinimum": 0.0,
      "maximum": 100.0,
      "title": "Sensor Height Mm",
      "type": "number"
    },
    "sensor_width_mm": {
      "default": 36.0,
      "exclusiveMinimum": 0.0,
      "maximum": 100.0,
      "title": "Sensor Width Mm",
      "type": "number"
    }
  },
  "required": [
    "fps",
    "frame_count",
    "samples"
  ],
  "title": "CameraCurveArtifact",
  "type": "object"
}
