# Copy this file to .env.local and fill only the values needed for your test.
# Never commit .env.local or real credentials.

OPENAI_API_KEY=

# Optional Director model override:
# CUTSCENEAI_DIRECTOR_MODEL=

# Optional external body-motion provider.
# CUTSCENEAI_BODY_PROVIDER=
