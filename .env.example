# CUTSCENEAI_BODY_MODEL_REVISION=
# CUTSCENEAI_BODY_PROMPT_VERSION=body-v0.1
# CUTSCENEAI_BODY_DETERMINISTIC=false
# CUTSCENEAI_BODY_PROVIDER_URL=
# CUTSCENEAI_BODY_PROVIDER_HEALTH_URL=
# CUTSCENEAI_BODY_PROVIDER_TOKEN=
# CUTSCENEAI_BODY_PROVIDER_TIMEOUT_SECONDS=600
